# Copy no values from this file into version control. Export real values in your shell,
# Docker secret provider, or untracked .env before invoking docker compose.

# Local infrastructure
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=portfolio
PORTFOLIO_MONGO_PORT=27017
TEMPORAL_POSTGRES_USER=
TEMPORAL_POSTGRES_PASSWORD=
TEMPORAL_POSTGRES_DB=temporal
PORTFOLIO_TEMPORAL_PORT=7233
PORTFOLIO_WEB_PORT=4321
# LAN demo only. Keep API, MongoDB, and Temporal unexposed.
PORTFOLIO_WEB_BIND_ADDRESS=0.0.0.0

# Spring API configuration: add real values only to untracked local secret storage.
SPRING_DATA_MONGODB_URI=
PORTFOLIO_PUBLIC_BASE_URL=
# Build-time public frontend configuration. Never set an API key here.
PUBLIC_SITE_URL=https://thatssatya.github.io
PUBLIC_ENABLE_LIVE_CAPABILITIES=false
# Local Compose only. The linked route remains Tailnet-gated by Nginx.
PUBLIC_ENABLE_OPERATOR_GITHUB_SETUP=true
# Local-only Astro dev/preview proxy target. It is not part of the browser build.
PORTFOLIO_API_ORIGIN=http://127.0.0.1:8080
PORTFOLIO_CRYPTO_CURRENT_KEY_ID=
PORTFOLIO_CRYPTO_CURRENT_KEY_BASE64=
PORTFOLIO_OAUTH_STATE_SIGNING_KEY=
PORTFOLIO_GITHUB_USERNAME=
# Disabled by default. The fine-grained PAT is accepted only by the private
# write-only endpoint; never set the PAT itself as an environment value.
PORTFOLIO_GITHUB_TOKEN_ENABLED=false
PORTFOLIO_GITHUB_TOKEN_KEY_ID=
PORTFOLIO_GITHUB_TOKEN_KEY_BASE64=
# Required before enabling token management. This is the pinned `portfolio-edge`
# Docker subnet used by the web reverse proxy (never a public, LAN, or Tailnet CIDR).
PORTFOLIO_GITHUB_TOKEN_TRUSTED_PROXY_CIDRS=172.30.0.0/24
PORTFOLIO_GITHUB_TOKEN_TAILNET_CIDRS=100.64.0.0/10,fd7a:115c:a1e0::/48
# Public GitHub activity remains absent until both flags are explicitly enabled
# and a PAT is submitted once through /operator/github/ on the Tailnet.
PORTFOLIO_GITHUB_REFRESH_ENABLED=false
PORTFOLIO_GITHUB_REFRESH_PUBLIC_APPROVED=false
PORTFOLIO_GITHUB_REFRESH_PROFILE_ID=github-primary
PORTFOLIO_GITHUB_REFRESH_HANDLE=thatssatya
PORTFOLIO_GITHUB_REFRESH_CRON=0 */15 * * * *
PORTFOLIO_SPOTIFY_CLIENT_ID=
PORTFOLIO_SPOTIFY_CLIENT_SECRET=
PORTFOLIO_META_APP_ID=
PORTFOLIO_META_APP_SECRET=
PORTFOLIO_YOUTUBE_API_KEY=
PORTFOLIO_LINKEDIN_CLIENT_ID=
PORTFOLIO_LINKEDIN_CLIENT_SECRET=
PORTFOLIO_LISTMONK_BASE_URL=
PORTFOLIO_LISTMONK_USERNAME=
PORTFOLIO_LISTMONK_PASSWORD=
PORTFOLIO_LISTMONK_LIST_ID=
PORTFOLIO_SMTP_HOST=
PORTFOLIO_SMTP_USERNAME=
PORTFOLIO_SMTP_PASSWORD=
PORTFOLIO_COLLECTOR_ID=
PORTFOLIO_COLLECTOR_HMAC_KEY_BASE64=
PORTFOLIO_TEMPORAL_TARGET=localhost:7233
PORTFOLIO_TEMPORAL_NAMESPACE=default
