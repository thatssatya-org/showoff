<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.samsepiol</groupId>
        <artifactId>bom</artifactId>
        <version>0.0.5-BOM-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.samsepiol.portfolio</groupId>
    <artifactId>portfolio-api</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>portfolio-api</name>
    <description>Cached public capability API for a self-hosted portfolio</description>

    <properties>
        <project.mainClass>com.samsepiol.portfolio.PortfolioApiApplication</project.mainClass>
        <samsepiol.library.version>0.0.4-LIBRARY-SNAPSHOT</samsepiol.library.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.samsepiol.library</groupId>
            <artifactId>library-core</artifactId>
            <version>${samsepiol.library.version}</version>
        </dependency>
        <dependency>
            <groupId>com.samsepiol.library</groupId>
            <artifactId>repository-models</artifactId>
            <version>${samsepiol.library.version}</version>
        </dependency>
        <dependency>
            <groupId>com.samsepiol.library</groupId>
            <artifactId>mongo</artifactId>
            <version>${samsepiol.library.version}</version>
        </dependency>
        <dependency>
            <groupId>com.samsepiol.library</groupId>
            <artifactId>guava</artifactId>
            <version>${samsepiol.library.version}</version>
        </dependency>
        <dependency>
            <groupId>com.samsepiol.library</groupId>
            <artifactId>http</artifactId>
            <version>${samsepiol.library.version}</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
