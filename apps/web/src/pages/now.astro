---
import RightNowCollection from "../components/RightNowCollection.astro";
import SignalMast from "../components/SignalMast.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { nowNote, rightNowItems } from "../data/site";
---

<BaseLayout title="Now — Satyajit Roy" description="A deliberate, owner-curated current field note.">
  <div class="frame field-layout">
    <SignalMast enabledSources={["curated"]} />
    <div class="content-field now-page">
      <header>
        <p class="eyebrow">Now</p>
        <h1>{nowNote.title}</h1>
        <p>{nowNote.body}</p>
        <small>{nowNote.updatedLabel}</small>
      </header>
      <RightNowCollection items={rightNowItems} />
    </div>
  </div>
</BaseLayout>

<style>
  .now-page { padding-block: clamp(2.5rem, 7vw, 6rem); }
  header { max-width: 46rem; padding-bottom: 2rem; }
  h1 { margin: 0.4rem 0 1rem; font-family: var(--font-display); font-size: clamp(3rem, 7vw, 5.5rem); letter-spacing: -0.07em; line-height: 0.85; }
  header > p:not(.eyebrow) { color: var(--muted); font-size: 1.08rem; }
  small { color: var(--accent); font-family: var(--font-mono); font-size: 0.72rem; }
</style>
