---
import { getCollection, render } from "astro:content";

import SignalMast from "../../components/SignalMast.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects", ({ data }) => data.visible);
  return projects.map((project) => ({ params: { slug: project.data.projectSlug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={`${project.data.title} — Satyajit Roy`} description={project.data.summary}>
  <div class="frame field-layout">
    <SignalMast enabledSources={["curated", "github"]} />
    <article class="content-field case-study">
      <p class="eyebrow">{project.data.sourceLabel}</p>
      <h1>{project.data.title}</h1>
      <p class="summary">{project.data.summary}</p>
      <ul aria-label="Technology used">
        {project.data.stack.map((technology) => <li>{technology}</li>)}
      </ul>
      {project.data.externalUrl && <a class="external" href={project.data.externalUrl} rel="external">Open source record</a>}
      <div class="case-study__body"><Content /></div>
      <a href="/projects">Back to projects</a>
    </article>
  </div>
</BaseLayout>

<style>
  .case-study { max-width: 48rem; padding-block: clamp(2.5rem, 7vw, 6rem); }
  h1 { margin: 0.5rem 0 1rem; font-family: var(--font-display); font-size: clamp(3rem, 8vw, 6.4rem); letter-spacing: -0.08em; line-height: 0.82; }
  .summary { color: var(--muted); font-size: 1.15rem; }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 1.5rem 0; padding: 0; list-style: none; }
  li { border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.5rem; font-family: var(--font-mono); font-size: 0.7rem; }
  .external { display: inline-block; margin-bottom: 2.5rem; }
  .case-study__body { border-block: 1px solid var(--line); color: var(--muted); margin-bottom: 2rem; padding-block: 1.5rem; }
  .case-study__body :global(p) { margin: 0; }
</style>
