---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Not found — Satyajit Roy" description="The requested field note is not published here.">
  <section class="not-found frame">
    <p class="eyebrow">404</p>
    <h1>Nothing public lives at this address.</h1>
    <p>It may have moved, expired, or never been approved for publication.</p>
    <div><a href="/">Return home</a><a href="/projects">Browse projects</a></div>
  </section>
</BaseLayout>

<style>
  .not-found { max-width: 58rem; padding-block: clamp(5rem, 17vw, 14rem); }
  h1 { margin: 0.5rem 0 1rem; font-family: var(--font-display); font-size: clamp(3rem, 9vw, 7rem); letter-spacing: -0.08em; line-height: 0.82; }
  .not-found > p:not(.eyebrow) { color: var(--muted); font-size: 1.1rem; }
  div { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 2rem; }
</style>
