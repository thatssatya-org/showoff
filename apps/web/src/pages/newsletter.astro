---
import SignalMast from "../components/SignalMast.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Newsletter — Satyajit Roy" description="The newsletter is not accepting subscriptions yet.">
  <div class="frame field-layout">
    <SignalMast enabledSources={["curated"]} />
    <section class="content-field newsletter-page" aria-labelledby="newsletter-title">
      <p class="eyebrow">Low-noise dispatch</p>
      <h1 id="newsletter-title">Dispatch is offline.</h1>
      <p class="intro">Subscriptions are not open while the sender domain and delivery boundary are being configured. This site does not collect email addresses.</p>
      <div class="newsletter-page__details section-rule">
        <h2>What is retained</h2>
        <p>No newsletter data is collected or retained. When subscriptions open, they will use a self-hosted double-opt-in flow with no tracking pixels.</p>
        <a href="/privacy">Read the privacy policy</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .newsletter-page { max-width: 48rem; padding-block: clamp(2.5rem, 7vw, 6rem); }
  h1, h2 { font-family: var(--font-display); letter-spacing: -0.065em; line-height: 0.88; }
  h1 { margin: 0.5rem 0 1.3rem; font-size: clamp(3rem, 7vw, 5.7rem); }
  .intro { color: var(--muted); font-size: 1.1rem; }
  .newsletter-page__details { margin-top: 3rem; padding-top: 1.5rem; }
  h2 { margin: 0 0 0.8rem; font-size: 1.8rem; }
  .newsletter-page__details p { color: var(--muted); }
</style>
