---
import NewsletterForm from "../components/NewsletterForm";
import SignalMast from "../components/SignalMast.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { newsletterConsent } from "../data/site";
---

<BaseLayout title="Newsletter — Satyajit Roy" description="A low-noise, double-opt-in newsletter without tracker pixels.">
  <div class="frame field-layout">
    <SignalMast enabledSources={["curated"]} />
    <section class="content-field newsletter-page" aria-labelledby="newsletter-title">
      <p class="eyebrow">Low-noise dispatch</p>
      <h1 id="newsletter-title">Occasional notes. No surveillance residue.</h1>
      <p class="intro">The newsletter runs through a self-hosted list manager. Confirm your address through double opt-in before anything is sent. Nothing on this page uses tracking pixels.</p>
      <NewsletterForm client:load consentVersion={newsletterConsent.version} consentText={newsletterConsent.text} />
      <div class="newsletter-page__details section-rule">
        <h2>What is retained</h2>
        <p>Subscription consent evidence and the address needed to deliver and manage the list. The public site does not expose list administration, delivery systems, or subscriber data.</p>
        <a href="/privacy">Read the privacy policy</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .newsletter-page { max-width: 48rem; padding-block: clamp(2.5rem, 7vw, 6rem); }
  h1, h2 { font-family: var(--font-display); letter-spacing: -0.065em; line-height: 0.88; }
  h1 { margin: 0.5rem 0 1.3rem; font-size: clamp(3rem, 7vw, 5.7rem); }
  .intro { color: var(--muted); font-size: 1.1rem; }
  .newsletter-page__details { margin-top: 3rem; padding-top: 1.5rem; }
  h2 { margin: 0 0 0.8rem; font-size: 1.8rem; }
  .newsletter-page__details p { color: var(--muted); }
</style>
