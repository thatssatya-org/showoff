---
interface Props {
  title: string;
  description: string;
  href?: string;
}

const { title, description, href } = Astro.props;
---

<article class="must-listen card card-reveal">
  <p class="section-label">Must listen</p>
  <h2>{title}</h2>
  <p>{description}</p>
  {href ? <a href={href} rel="external">Open in Spotify</a> : <p class="awaiting">Link pending owner approval</p>}
</article>

<style>
  .must-listen {
    min-height: 100%;
    padding: 1.25rem;
  }

  h2 {
    margin: 2.5rem 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.6rem);
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  p { margin: 0; }

  .must-listen > p:not(.section-label):not(.awaiting) {
    color: var(--muted);
  }

  a,
  .awaiting {
    display: inline-block;
    margin-top: 1.5rem;
  }

  .awaiting {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
