---
import type { RightNowItem } from "../data/site";

interface Props {
  items: readonly RightNowItem[];
}

const { items } = Astro.props;
---

<section class="right-now" aria-labelledby="right-now-title">
  <div class="right-now__heading">
    <p class="section-label">Curated collection</p>
    <h2 id="right-now-title">Top things right now</h2>
  </div>
  <div class="right-now__grid">
    {
      items.map((item) => (
        <article class:list={["right-now__item", "card", "card-reveal", item.presentation && `right-now__item--${item.presentation}`]} data-source={item.source}>
          <p class="section-label">{item.source}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          {
            item.presentation === "spotify-player" && item.embedUrl ? (
              <iframe
                class="right-now__spotify-player"
                src={item.embedUrl}
                title={`Spotify playlist: ${item.title}`}
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
              ></iframe>
            ) : item.presentation === "photo-carousel" && item.photos ? (
              <div class="right-now__carousel" aria-label={`Photo carousel: ${item.title}`}>
                <div class="right-now__track" tabindex="0">
                  {item.photos.map((photo, index) => (
                    <a class="right-now__slide" href={item.href} rel="external" aria-label={`Open Aero India album, photo ${index + 1} of ${item.photos?.length}`}>
                      <img src={photo.src} alt={photo.alt} loading={index === 0 ? "eager" : "lazy"} />
                    </a>
                  ))}
                </div>
                <p class="right-now__carousel-hint">Swipe or scroll · <a href={item.href} rel="external">open the full album ↗</a></p>
              </div>
            ) : null
          }
          {item.presentation !== "photo-carousel" && <a href={item.href} rel="external">{item.presentation === "spotify-player" ? "Open in Spotify ↗" : "Open link"}</a>}
        </article>
      ))
    }
  </div>
</section>

<style>
  .right-now { padding-block: 1.5rem; }
  .right-now__heading { margin-bottom: 1rem; }
  h2, h3 { font-family: var(--font-display); letter-spacing: -0.04em; }
  h2 { margin: 0.2rem 0 0; font-size: clamp(1.8rem, 4vw, 2.7rem); }
  .right-now__grid { display: grid; gap: 0.75rem; }
  .right-now__item { display: grid; gap: 0.75rem; padding: 1rem; }
  h3, p { margin: 0; }
  h3 { font-size: 1.28rem; }
  .right-now__item > p:not(.section-label) { color: var(--muted); font-size: 0.92rem; }
  .right-now__item--spotify-player { grid-template-columns: minmax(0, 1fr); }
  .right-now__spotify-player { display: block; width: 100%; height: 152px; border: 0; border-radius: 0.7rem; }
  .right-now__item--photo-carousel { overflow: hidden; padding-bottom: 0.85rem; }
  .right-now__carousel { min-width: 0; }
  .right-now__track { display: flex; gap: 0.65rem; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-inline: contain; scrollbar-width: thin; scrollbar-color: var(--mast-line) transparent; padding-bottom: 0.5rem; }
  .right-now__slide { flex: 0 0 86%; aspect-ratio: 4 / 3; scroll-snap-align: start; overflow: hidden; border: 1px solid var(--line); border-radius: 0.45rem; background: var(--surface-raised); }
  .right-now__slide img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 180ms ease-out; }
  .right-now__slide:hover img { transform: scale(1.025); }
  .right-now__carousel-hint { margin-top: 0.15rem !important; color: var(--muted); font-family: var(--font-mono); font-size: 0.68rem !important; }
  .right-now__carousel-hint a { color: var(--ink); }
  @media (min-width: 720px) { .right-now__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .right-now__item--spotify-player { grid-column: span 2; } }
</style>
