---
import type { RightNowItem } from "../data/site";

interface Props {
  items: readonly RightNowItem[];
}

const { items } = Astro.props;
---

<section class="right-now" aria-labelledby="right-now-title">
  <div class="right-now__heading">
    <p class="section-label">Curated collection</p>
    <h2 id="right-now-title">Top things right now</h2>
  </div>
  <div class="right-now__grid">
    {
      items.map((item) => (
        <article class="right-now__item card card-reveal" data-source={item.source}>
          <p class="section-label">{item.source}</p>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          {item.href ? <a href={item.href} rel="external">Open link</a> : <span class="awaiting">Destination awaiting approval</span>}
        </article>
      ))
    }
  </div>
</section>

<style>
  .right-now { padding-block: 1.5rem; }
  .right-now__heading { margin-bottom: 1rem; }
  h2, h3 { font-family: var(--font-display); letter-spacing: -0.04em; }
  h2 { margin: 0.2rem 0 0; font-size: clamp(1.8rem, 4vw, 2.7rem); }
  .right-now__grid { display: grid; gap: 0.75rem; }
  .right-now__item { display: grid; gap: 0.75rem; padding: 1rem; }
  h3, p { margin: 0; }
  h3 { font-size: 1.28rem; }
  .right-now__item > p:not(.section-label) { color: var(--muted); font-size: 0.92rem; }
  .awaiting { color: var(--muted); font-family: var(--font-mono); font-size: 0.68rem; }
  @media (min-width: 720px) { .right-now__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
