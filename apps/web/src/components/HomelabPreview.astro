---
interface Props {
  title: string;
  body: string;
  categories: readonly string[];
}

const { title, body, categories } = Astro.props;
---

<section class="homelab-preview card" aria-labelledby="homelab-preview-title">
  <p class="section-label">Systems story</p>
  <h2 id="homelab-preview-title">{title}</h2>
  <p>{body}</p>
  <ul aria-label="Public-safe service categories">
    {categories.map((category) => <li>{category}</li>)}
  </ul>
  <a href="/homelab">Read the operating principles</a>
</section>

<style>
  .homelab-preview { display: grid; gap: 1rem; padding: 1.25rem; }
  h2, p { margin: 0; }
  h2 { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 2.8rem); letter-spacing: -0.05em; line-height: 0.95; }
  p:not(.section-label) { max-width: 52rem; color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  li { border-bottom: 1px solid var(--mast-line); font-family: var(--font-mono); font-size: 0.72rem; padding-bottom: 0.15rem; }
</style>
