---
import type { SocialLink } from "../data/site";
import SocialIcon from "./SocialIcon.astro";

interface Props {
  name: string;
  identityLine: string;
  themes: readonly string[];
  thesis: string;
  location: string;
  contactLabel: string;
  contactHref: string;
  socialLinks: readonly SocialLink[];
  newsletterEnabled: boolean;
}

const { name, identityLine, themes, thesis, location, contactLabel, contactHref, socialLinks, newsletterEnabled } = Astro.props;

---

<header class="identity-masthead">
  <p class="eyebrow">Owner-curated public record</p>
  <div class="identity-masthead__topline">
    <h1>{name}</h1>
    {newsletterEnabled && <a class="subscribe-link" href="/newsletter">Subscribe</a>}
  </div>
  <p class="identity-line">{identityLine}</p>
  <p class="themes">{themes.join("  |  ")}</p>
  <p class="thesis">{thesis}</p>
  <p class="location">Based in {location}. <a href={contactHref} rel="me external">{contactLabel}</a>.</p>
  <nav class="social-rail" aria-label="Profiles and contact">
    {
      socialLinks.map((link) => <a href={link.href} rel="me external" aria-label={link.label} title={link.label}><SocialIcon label={link.label} /></a>)
    }
  </nav>
</header>

<style>
  .identity-masthead {
    display: grid;
    gap: 1rem;
    padding-block: clamp(2.4rem, 7vw, 6rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .identity-masthead__topline {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.2rem, 8.5vw, 7.2rem);
    font-variation-settings: "CASL" 0.35, "wght" 760;
    font-weight: 760;
    letter-spacing: -0.065em;
    line-height: 0.88;
  }

  .subscribe-link {
    min-height: 2.75rem;
    border: 1px solid var(--signal);
    border-radius: 0.35rem;
    color: var(--signal);
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    text-decoration: none;
  }

  .identity-line {
    max-width: 42rem;
    margin: 0;
    font-size: clamp(1.12rem, 1.6vw, 1.35rem);
    line-height: 1.35;
    font-weight: 600;
  }

  .themes,
  .thesis,
  .location {
    max-width: 54rem;
    margin: 0;
  }

  .themes {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.035em;
    text-transform: uppercase;
  }

  .thesis {
    color: var(--muted);
  }

  .location {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .social-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.25rem;
    font-size: 0.9rem;
  }

  .social-rail a {
    width: 2.5rem;
    min-height: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: border-color 180ms ease-out, background-color 180ms ease-out, color 180ms ease-out;
  }

  .social-rail a:hover,
  .social-rail a:focus-visible {
    border-color: var(--signal);
    background: color-mix(in srgb, var(--signal) 12%, transparent);
    color: var(--signal);
  }

  .social-rail :global(.social-icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (max-width: 500px) {
    .identity-masthead__topline {
      align-items: flex-end;
    }

    .subscribe-link {
      flex-shrink: 0;
    }
  }
</style>
