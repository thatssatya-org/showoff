---
import type { CollectionEntry } from "astro:content";

interface Props {
  projects: readonly CollectionEntry<"projects">[];
  compact?: boolean;
}

const { projects, compact = false } = Astro.props;
---

<div class:list={["project-grid", { "project-grid--compact": compact }]}>
  {
    projects.map((project) => (
      <article class="project-card card card-reveal" data-source="curated">
        <p class="section-label">{project.data.sourceLabel}</p>
        <h3><a href={`/projects/${project.data.projectSlug}`}>{project.data.title}</a></h3>
        <p>{project.data.summary}</p>
        <ul aria-label={`${project.data.title} technology`}>
          {project.data.stack.map((technology) => <li>{technology}</li>)}
        </ul>
        <a class="project-card__read" href={`/projects/${project.data.projectSlug}`}>Read field note</a>
      </article>
    ))
  }
</div>

<style>
  .project-grid { display: grid; gap: 0.75rem; }
  .project-card { display: grid; gap: 0.9rem; padding: 1.25rem; }
  h3, p { margin: 0; }
  h3 { font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.2rem); letter-spacing: -0.05em; line-height: 0.95; }
  h3 a { text-decoration: none; }
  .project-card > p:not(.section-label) { color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0; padding: 0; list-style: none; }
  li { border: 1px solid var(--line); border-radius: 999px; padding: 0.15rem 0.45rem; font-family: var(--font-mono); font-size: 0.68rem; }
  .project-card__read { margin-top: 0.3rem; font-size: 0.9rem; }
  @media (min-width: 720px) { .project-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .project-grid--compact { grid-template-columns: 1fr; } }
</style>
